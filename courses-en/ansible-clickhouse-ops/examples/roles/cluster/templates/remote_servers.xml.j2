<clickhouse>
  <remote_servers>
    <{{ nimbus_cluster_name }}>
      <shard>
        <internal_replication>true</internal_replication>
{% for host in groups['clickhouse'] %}
        <replica>
          <host>{{ hostvars[host].ansible_host }}</host>
          <port>{{ nimbus_native_port }}</port>
        </replica>
{% endfor %}
      </shard>
    </{{ nimbus_cluster_name }}>
  </remote_servers>
</clickhouse>
