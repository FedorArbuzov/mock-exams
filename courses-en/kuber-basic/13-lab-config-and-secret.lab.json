{
  "id": "kuber-basic/13-lab-config-and-secret",
  "title": "Lab: ConfigMap and Secret",
  "setup": [
    { "op": "ensureNamespace", "name": "lab-cs" },
    { "op": "delete", "kind": "configmap", "namespace": "lab-cs", "name": "app-config" },
    { "op": "delete", "kind": "secret", "namespace": "lab-cs", "name": "db-secret" }
  ],
  "checks": [
    { "type": "exists", "kind": "configmap", "namespace": "lab-cs", "name": "app-config", "desc": "ConfigMap 'app-config' exists (Task 1)" },
    { "type": "hasKey", "kind": "configmap", "namespace": "lab-cs", "name": "app-config", "key": "GREETING", "desc": "app-config has key GREETING" },
    { "type": "hasKey", "kind": "configmap", "namespace": "lab-cs", "name": "app-config", "key": "LOG_LEVEL", "desc": "app-config has key LOG_LEVEL" },
    { "type": "exists", "kind": "secret", "namespace": "lab-cs", "name": "db-secret", "desc": "Secret 'db-secret' exists (Task 4)" },
    { "type": "hasKey", "kind": "secret", "namespace": "lab-cs", "name": "db-secret", "key": "DB_USER", "desc": "db-secret has key DB_USER" },
    { "type": "hasKey", "kind": "secret", "namespace": "lab-cs", "name": "db-secret", "key": "DB_PASSWORD", "desc": "db-secret has key DB_PASSWORD" }
  ],
  "cleanup": [
    { "op": "deleteNamespace", "name": "lab-cs" }
  ]
}
