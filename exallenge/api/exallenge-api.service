[Unit]
Description=Exallenge analytics API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/exallenge-api
EnvironmentFile=/opt/exallenge-api/env
ExecStart=/opt/exallenge-api/exallenge-api
Restart=on-failure
RestartSec=3

# Hardening (basic)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/exallenge-api/data

[Install]
WantedBy=multi-user.target
